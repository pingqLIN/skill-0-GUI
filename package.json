    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
