    "express": "^4.22.2",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-3d": "^1.29.1",
    "react-i18next": "^16.5.6",
    "recharts": "^3.7.0",
