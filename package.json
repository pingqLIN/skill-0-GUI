{
  "name": "skill-0-review-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3005 --host=0.0.0.0",
    "build": "vite build",
    "build:public": "VITE_ENABLE_3D=false vite build",
    "verify:build-size": "npm run build && node scripts/verify-build-size.mjs",
    "verify:public-build": "node scripts/verify-public-build.mjs",
    "preview": "vite preview",
    "start": "node server.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:sync": "node scripts/sync-shared-docs.mjs",
    "docs:check": "node scripts/sync-shared-docs.mjs --check"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-3d": "^1.29.1",
    "react-i18next": "^16.5.6",
    "recharts": "^3.7.0",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "path-to-regexp": "0.1.13",
    "picomatch": "4.0.4"
  }
}
