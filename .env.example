# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Used by the standalone production server in server.mjs.
PORT="4173"

# SKILL0_MODE: "auto" uses the external skill-0 repo when available.
# Set to "standalone" for an externally deployed web app that must not depend
# on any local /home/miles/... repository.
SKILL0_MODE="auto"

# SKILL0_PARSER_ROOT: Optional override for the primary skill-0 repository bridge.
# When omitted, the GUI tries /home/miles/dev2/skill-0 first, then
# /home/miles/dev/projects/skill-0, and finally falls back to its bundled
# standalone parser if neither repository is available.
SKILL0_PARSER_ROOT="/home/miles/dev2/skill-0"

# SKILL0_ROOT: Backward-compatible alias. Prefer SKILL0_PARSER_ROOT for new setups.
# SKILL0_ROOT="/home/miles/dev2/skill-0"

# VITE_ENABLE_3D: Build-time flag for the optional VectorSpace 3D view.
# Set to "false" for public deployments that should avoid the heavy 3D bundle.
VITE_ENABLE_3D="true"
