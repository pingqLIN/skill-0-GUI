# APP_URL: Optional public origin for hosted environments.
# Use this only when the deployment platform or future integrations need a
# canonical external URL. The current Render profile does not require it.
APP_URL="MY_APP_URL"

# PORT: Used by the standalone production server in server.mjs.
PORT="4173"

# SKILL0_MODE: "auto" uses the external skill-0 repo when available.
# Set to "standalone" for public deployments that must not depend on any
# local /home/... repository. This is the recommended Render profile.
SKILL0_MODE="auto"

# SKILL0_PARSER_ROOT: Optional override for the canonical skill-0 repository bridge.
# Omit this in public standalone deployments. Set it only for internal or
# controlled environments that intentionally expose canonical parser behavior.
SKILL0_PARSER_ROOT="/home/miles/dev2/skill-0"

# SKILL0_ROOT: Backward-compatible alias. Prefer SKILL0_PARSER_ROOT for new setups.
# SKILL0_ROOT="/home/miles/dev2/skill-0"

# SKILL0_API_BODY_LIMIT: Optional JSON body limit for upload and bundle parsing.
# The default is 10mb. Increase it only if review bundles regularly exceed that.
# SKILL0_API_BODY_LIMIT="10mb"

# SKILL0_REQUEST_TIMEOUT_MS: End-to-end timeout for a single parser request.
# Public hosts should keep this bounded so slow provider calls degrade clearly.
# SKILL0_REQUEST_TIMEOUT_MS="20000"

# SKILL0_LLM_MODE: "fallback" enables the server-side recovery path after
# canonical/standalone parsing fails or produces an unusably sparse result.
# Leave this as "disabled" for fully deterministic local workflows.
SKILL0_LLM_MODE="disabled"

# SKILL0_LLM_PROVIDER: Provider-neutral adapter selector. Current build
# implements a working OpenAI adapter and keeps other providers disabled.
# SKILL0_LLM_PROVIDER="openai"

# SKILL0_LLM_MODEL: Optional model override. The OpenAI adapter defaults to
# gpt-4o-mini when provider + key are present.
# SKILL0_LLM_MODEL="gpt-4o-mini"

# SKILL0_LLM_API_KEY: Server-side secret used by the LLM recovery adapter.
# Never expose this through Vite-prefixed variables.
# SKILL0_LLM_API_KEY="sk-..."

# SKILL0_LLM_TIMEOUT_MS: Provider request timeout for the LLM recovery adapter.
# SKILL0_LLM_TIMEOUT_MS="15000"

# SKILL0_LLM_MAX_INPUT_CHARS: Prompt budget guardrail for fallback recovery.
# SKILL0_LLM_MAX_INPUT_CHARS="12000"

# SKILL0_RUNTIME_CONFIG_MUTABLE: Allows the in-app LLM admin console to update
# mode/provider/model/timeout/input guards and an in-memory API key at runtime.
# Defaults to true outside production and false in production builds.
# SKILL0_RUNTIME_CONFIG_MUTABLE="true"

# VITE_ENABLE_3D: Build-time flag for the optional VectorSpace 3D view.
# Set to "false" for public deployments that should avoid the heavy 3D bundle.
# The recommended Render profile builds with VITE_ENABLE_3D=false.
VITE_ENABLE_3D="true"
